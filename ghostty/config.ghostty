# Ghostty - cbdotfiles config
# Reload: Cmd+Shift+, (macOS) | Ctrl+Shift+, (Linux)

# Font
font-family = CaskaydiaMono Nerd Font
font-size = 13
font-thicken = true

# Window
window-padding-x = 14
window-padding-y = 14
window-decoration = auto
confirm-close-surface = false

# Cursor
cursor-style = block

# Transparency
background-opacity = 0.85

# Bell
audible-bell = false

# Theme (dark:theme-escuro, light:theme-claro)
# theme = dark:monokai,light:solarized-light

# macOS specific
macos-option-as-alt = true
