# Font
font-family = CaskaydiaMono Nerd Font
font-size = 13
font-thicken = true

# Window
window-padding-x = 14
window-padding-y = 14
window-decoration = auto
confirm-close-surface = false

# Cursor
cursor-style = block

# Bell
audible-bell = false

# Environment-specific overrides (symlinked pelo installer)
config-file = ?~/.config/ghostty/env.conf

# Local overrides (machine-specific, nao vai pro git)
config-file = ?~/.config/ghostty/local.conf
