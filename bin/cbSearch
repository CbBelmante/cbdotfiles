#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════════
# cbSearch - Busca interativa genérica com fzf
# Data-driven: recebe JSON, mostra busca fuzzy com preview
# ═══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

# ───────────────────────────────────────────────────────────────────────────────
# Configuração
# ───────────────────────────────────────────────────────────────────────────────

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly DATA_DIR="${SCRIPT_DIR}/../data"

# ───────────────────────────────────────────────────────────────────────────────
# Helpers
# ───────────────────────────────────────────────────────────────────────────────

show_usage() {
  cat << EOF
🔍 cbSearch - Busca interativa genérica

USO:
  cbSearch <arquivo.json>
  cbSearch nvim-tips       # atalho para data/nvim-tips.json
  cbSearch sql-help        # atalho para data/sql-help.json

EXEMPLOS:
  cbSearch nvim-tips
  cbSearch ~/.config/my-commands.json

BUSCA:
  - Nome do comando
  - Descrição
  - Tags
  - Categoria

NAVEGAÇÃO:
  ↑↓      Navegar
  Enter   Copiar comando pro clipboard
  Esc     Sair

EOF
}

# ───────────────────────────────────────────────────────────────────────────────
# Funções principais
# ───────────────────────────────────────────────────────────────────────────────

resolve_json_path() {
  local input="$1"

  # Se é caminho absoluto ou relativo com /, usa direto
  if [[ "$input" == /* ]] || [[ "$input" == ./* ]] || [[ "$input" == */* ]]; then
    echo "$input"
    return
  fi

  # Se termina com .json, assume que tá no data/
  if [[ "$input" == *.json ]]; then
    echo "${DATA_DIR}/${input}"
    return
  fi

  # Senão, adiciona .json e procura no data/
  echo "${DATA_DIR}/${input}.json"
}

extract_items() {
  local json_file="$1"

  # Extrai items com TAGS pra busca fuzzy
  # Formato: comando\tdescrição\tcategoria\tname\ttags
  jq -r '.items[] |
    "\(.command // .name)\t\(.description)\t\(.category // "Geral")\t\(.name)\t\((.tags // []) | join(" "))"' \
    "$json_file"
}

format_for_fzf() {
  # Formata cada linha pra fzf
  # Input: comando\tdescrição\tcategoria\tname\ttags
  # Output: "comando - descrição (categoria) #tags"
  # Tags ficam ao final pra busca fuzzy funcionar nelas também!
  while IFS=$'\t' read -r command desc category name tags; do
    if [[ -n "$tags" ]]; then
      # Com tags (discretas, mas buscáveis)
      printf "%-20s %s (%s) %s\n" "$command" "$desc" "$category" "$tags"
    else
      # Sem tags
      printf "%-20s %s (%s)\n" "$command" "$desc" "$category"
    fi
  done
}

copy_to_clipboard() {
  local text="$1"

  # Tenta wl-copy (Wayland)
  if command -v wl-copy &> /dev/null; then
    echo -n "$text" | wl-copy
    return 0
  fi

  # Tenta xclip (X11)
  if command -v xclip &> /dev/null; then
    echo -n "$text" | xclip -selection clipboard
    return 0
  fi

  return 1
}

run_search() {
  local json_file="$1"

  # Valida JSON
  if ! jq empty "$json_file" 2>/dev/null; then
    echo "❌ Erro: JSON inválido em $json_file"
    exit 1
  fi

  # Pega título do JSON
  local title
  title=$(jq -r '.title // "Busca"' "$json_file")

  # Extrai e formata items
  local items
  items=$(extract_items "$json_file" | format_for_fzf)

  if [[ -z "$items" ]]; then
    echo "❌ Nenhum item encontrado em $json_file"
    exit 1
  fi

  # Roda fzf com preview
  local selected
  local preview_script="${SCRIPT_DIR}/.cbSearch-preview.sh"

  selected=$(echo "$items" | fzf \
    --ansi \
    --layout=reverse \
    --height=100% \
    --header="🔍 $title - Busca fuzzy (Enter = copiar comando)" \
    --header-first \
    --prompt="❯ " \
    --pointer="▶" \
    --preview="$preview_script '$json_file' {}" \
    --preview-window=right:60%:wrap \
    --bind='ctrl-/:toggle-preview' \
    --color='header:italic:cyan,prompt:bold:cyan,pointer:bold:green' \
  ) || return 0

  if [[ -n "$selected" ]]; then
    # Extrai comando
    local command
    command=$(echo "$selected" | awk '{print $1}')

    # Copia pro clipboard
    if copy_to_clipboard "$command"; then
      echo "✅ Comando copiado: $command"
    else
      echo "📋 Comando: $command"
      echo "⚠️  Clipboard não disponível (instale wl-copy ou xclip)"
    fi
  fi
}

# ───────────────────────────────────────────────────────────────────────────────
# Main
# ───────────────────────────────────────────────────────────────────────────────

main() {
  # Valida argumentos
  if [[ $# -eq 0 ]] || [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
    show_usage
    exit 0
  fi

  # Valida dependências
  if ! command -v fzf &> /dev/null; then
    echo "❌ Erro: fzf não encontrado"
    echo "Instale: sudo apt install fzf"
    exit 1
  fi

  if ! command -v jq &> /dev/null; then
    echo "❌ Erro: jq não encontrado"
    echo "Instale: sudo apt install jq"
    exit 1
  fi

  # Resolve caminho do JSON
  local json_file
  json_file=$(resolve_json_path "$1")

  if [[ ! -f "$json_file" ]]; then
    echo "❌ Erro: arquivo não encontrado: $json_file"
    exit 1
  fi

  # Roda busca
  run_search "$json_file"
}

main "$@"
