# ═══════════════════════════════════════════════════════════════════════════════
# CBDOTFILES GIT CONFIG (compartilhavel)
# ═══════════════════════════════════════════════════════════════════════════════
# Nome/email sao configurados durante o install (git config --global)
# Este arquivo e incluido via: git config --global include.path <path>
# NAO symlinke este arquivo pra ~/.gitconfig — use include.path
# ═══════════════════════════════════════════════════════════════════════════════

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[core]
	editor = nvim
	autocrlf = input
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Dracula

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	lg = log --oneline --graph --decorate --all
	last = log -1 HEAD
	unstage = reset HEAD --
